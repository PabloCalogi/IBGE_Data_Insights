<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IBGE_Data_Insights.Views.MainPage"
             Title="Demografia de Nomes - IBGE">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Selecione um Estado:" FontSize="16" FontAttributes="Bold" />

            <Picker x:Name="EstadoPicker" 
                    Title="Toque para selecionar"
                    ItemDisplayBinding="{Binding nome}" 
                    SelectedIndexChanged="OnEstadoSelecionado" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />

            <Label Text="Nomes mais comuns (Censo 2022)" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="10">
                    <Label Text="Homens" TextColor="Blue" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <CollectionView x:Name="ListaHomens" HeightRequest="450">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,5" Stroke="LightGray">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding nome}" FontAttributes="Bold" FontSize="14"/>
                                        <Label Text="{Binding frequencia, StringFormat='Frequência: {0}'}" FontSize="12" TextColor="Gray"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="10">
                    <Label Text="Mulheres" TextColor="DeepPink" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <CollectionView x:Name="ListaMulheres" HeightRequest="450">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,5" Stroke="LightGray">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding nome}" FontAttributes="Bold" FontSize="14"/>
                                        <Label Text="{Binding frequencia, StringFormat='Frequência: {0}'}" FontSize="12" TextColor="Gray"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>